{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.15.0/.schema/devbox.schema.json",
  "packages": ["bun@1"],
  "env": {
    "MCPORTER_CONFIG": "mcporter.json"
  },
  "shell": {
    "init_hook": ["test -e .envrc.private || cp .envrc.example .envrc.private"],
    "scripts": {
      "verify": "bun install && bun tsc && bun test",
      "cli": "bun install && bun cli",
      "install-on-system": "mkdir -p ~/.local/bin && bun build --compile --outfile ~/.local/bin/desk-cli ./cli/index.ts"
    }
  }
}
